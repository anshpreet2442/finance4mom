# Pretty URLs: everything that is not a real file goes to index.php
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>

# Never serve configuration, source or tooling directly
<FilesMatch "^(config\.php|router\.php|package(-lock)?\.json|composer\.(json|lock)|README\.md)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(.*/)?(tools|docs)/

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  # PHP sends X-Frame-Options itself (DENY, or SAMEORIGIN for the layout preview). Do NOT set it here for every file: on real Apache,
  # "Header always setifempty" only looks at its own header table, not at the headers PHP set, so both would be sent ("SAMEORIGIN, DENY")
  # and browsers then refuse the layout preview frame. Only static files, which PHP never answers, get the default.
  <FilesMatch "\.(css|js|svg|png|jpg|webp|woff2?)$">
    Header always setifempty X-Frame-Options "DENY"
  </FilesMatch>
  <FilesMatch "\.(css|js|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
